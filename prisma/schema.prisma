  STYLELINT
  TSUP
  BUNFIG
  GITIGNORE
  PACKAGE_JSON
  TSCONFIG
  WINDSURF_RULES
  AGENTS_MD
  CLAUDE_MD
  CURSOR_RULES
  VSCODE
  APPLAB_CONFIG
  COMPONENTS_JSON
}

/// Enum for application types
enum AppType {
  WEB_APP
  DESKTOP_APP
  MOBILE_APP
  API
  MARKETING_SITE
  LIBRARY
  MONOREPO
  CLI
  EXTENSION
  CUSTOM
}

/// Enum for configuration scope/level
enum ConfigScope {
  GLOBAL
  TEMPLATE
  PROJECT
  APP
}

/// Enum for dependency types
enum DependencyType {
  REGULAR
  DEV
  PEER
  OPTIONAL
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
  CONFLICT
}

enum Feature {
  AI
  ANALYTICS
  API_DOCS
  BACKGROUND_JOBS
  BLOB_STORAGE
  CACHING
  CMS
  DATABASE
  DEV_CONTAINERS
  EMAIL
  ERROR_REPORTING
  FEATURE_FLAGS
  FINANCIAL_ACCOUNTS
  I18N
  LOGGING
  NOTIFICATIONS
  PAYMENTS
  RATE_LIMITING
  REALTIME
  SCRAPING
  SEARCH
  SEO
  SPEED_INSIGHTS
  SSO
  TESTING
  USER_AUTH
}

enum AgentRole {
  DESIGNER
  FRONTEND_ENGINEER
  BACKEND_ENGINEER
  FULLSTACK_ENGINEER
  QA_ENGINEER
  DEVOPS_ENGINEER
  PRODUCT_OWNER
  SCRUM_MASTER
  TECH_LEAD
  CUSTOM
}

enum AgentSpecialization {
  GENERALIST
  REACT
  VUE
  ANGULAR
  NODEJS
  PYTHON
  GOLANG
  RUST
  DATABASE
  CLOUD_AWS
  CLOUD_GCP
  CLOUD_AZURE
  KUBERNETES
  TESTING
  UI_UX
  ACCESSIBILITY
  PERFORMANCE
  SECURITY
  MOBILE
  CUSTOM
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  QA
  BLOCKED
  DONE
  DESIGN
  UNREFINED
  READY
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Component library items
model Component {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String
  category        String
  type            ComponentType       @default(COMPONENT)
  code            String              @db.Text
  demoCode        String?             @db.Text
  documentation   String?             @db.Text
  props           Json?
  tags            String[]
  isPublished     Boolean             @default(true)
  order           Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  revisions       ComponentRevision[]
  /// RAG embedding status
  embeddingStatus EmbeddingStatus     @default(PENDING)
  embeddedAt      DateTime?

  @@index([category, isPublished])
  @@index([type, isPublished])
  @@index([embeddingStatus])
  @@map("components")
}

/// Component revision history with AI modifications
model ComponentRevision {
  id          String         @id @default(cuid())
  componentId String
  code        String         @db.Text
  description String
  prompt      String         @db.Text
  explanation String?        @db.Text
  status      RevisionStatus @default(PENDING)
  isCurrent   Boolean        @default(false)
  userId      String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  component   Component      @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId, status])
  @@index([componentId, isCurrent])
  @@index([userId])
  @@map("component_revisions")
}

enum ComponentType {
  COMPONENT
  BACKGROUND
  LAYOUT
  HOOK
  UTILITY
}

enum RevisionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ==========================================
// RAG (Retrieval-Augmented Generation) Models
// ==========================================

/// Embedding storage for semantic search across all content types
model Embedding {
  id String @id @default(cuid())

  /// Source reference (polymorphic)
  sourceType EmbeddingSourceType
  sourceId   String
  chunkIndex Int                 @default(0)

  /// Content
  contentText String @db.Text
  contentHash String /// SHA-256 hash for deduplication

  /// Vector stored via raw SQL (not in Prisma) - 1536 dimensions for text-embedding-3-small
  /// embedding vector(1536)

  /// Metadata for filtering and reranking
  projectId  String?
  category   String?
  importance Int     @default(5) /// 1-10 scale
  metadata   Json    @default("{}")

  /// Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
  @@index([projectId])
  @@index([category])
  @@index([contentHash])
  @@map("embeddings")
}

/// Track embedding job status for background processing
model EmbeddingJob {
  id String @id @default(cuid())

  /// Job details
  sourceType EmbeddingSourceType
  sourceId   String
  status     EmbeddingJobStatus  @default(PENDING)

  /// Progress tracking
  totalChunks     Int @default(0)
  processedChunks Int @default(0)

  /// Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  /// Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status])
  @@index([sourceType, sourceId])
  @@map("embedding_jobs")
}

/// Cache for query embeddings to avoid re-embedding repeated queries
model QueryEmbeddingCache {
  id        String @id @default(cuid())
  queryHash String @unique
  queryText String
  /// embedding vector stored via raw SQL

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@map("query_embedding_cache")
}

/// Source types that can be embedded for RAG
enum EmbeddingSourceType {
  PROJECT_MEMORY
  KNOWLEDGE_DOCUMENT
  AGENT_MEMORY
  BEST_PRACTICE
  COMPONENT
  CONFIG_TEMPLATE
  TICKET
  CODEBASE_FILE
}

/// Status of embedding jobs
enum EmbeddingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Status of embedding for individual records
enum EmbeddingStatus {
  PENDING /// Not yet embedded
  PROCESSING /// Currently being embedded
  COMPLETED /// Successfully embedded
  FAILED /// Embedding failed
  STALE /// Content changed, needs re-embedding
}

enum NotificationKind {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind @default(INFO)
  title     String
  message   String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([readAt])
  @@index([kind])
  @@map("notifications")
}

// ===========================================
// AI Agent Skills
// ===========================================

/// AI Agent Skill - follows Agent Skills spec
model Skill {
  id            String        @id @default(cuid())
  name          String        @unique // kebab-case, 1-64 chars
  displayName   String // Human-readable name
  description   String        @db.Text // 1-1024 chars, describes what + when
  category      SkillCategory
  content       String        @db.Text // SKILL.md body content
  license       String? // e.g., "MIT", "Apache-2.0"
  compatibility String? // Environment requirements
  author        String?
  version       String?
  allowedTools  String[] // Pre-approved tools
  tags          String[] // Search/filter tags
  isOfficial    Boolean       @default(false)
  isEnabled     Boolean       @default(true)
  usageCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([isEnabled])
  @@index([tags])
  @@map("skills")
}

enum SkillCategory {
  FRONTEND
  BACKEND
  FULLSTACK
  DATABASE
  DEVOPS
  TESTING
  SECURITY
  PERFORMANCE
  ACCESSIBILITY
  DOCUMENTATION
  ARCHITECTURE
  TOOLING
  AI_ML
  MOBILE
  API
  STYLING
  STATE_MANAGEMENT
  BUILD_TOOLS
  VERSION_CONTROL
  DEBUGGING
  DEPLOYMENT
  MONITORING
  OTHER
}
