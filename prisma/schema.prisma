  PRETTIER
  TYPESCRIPT
  TAILWIND
  NEXTJS
  BABEL
  EXPO
  POSTCSS
  VITE
  JEST
  PLAYWRIGHT
  VITEST
  TURBO
  SENTRY
  VERCEL
